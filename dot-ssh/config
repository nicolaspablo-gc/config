# -*- mode: conf -*-
# Machine-specific hosts and overrides (not versioned).
# Included first so its host-specific settings win; ssh uses the first value found.
Include local.conf

# Defaults for every host (these only fill in what local.conf didn't set)
Host *
    # Connection sharing: later sessions reuse the open connection
    ControlMaster auto
    ControlPath ~/.ssh/cm-%C
    ControlPersist 1h

    # Keep idle connections from being dropped by firewalls/NAT
    ServerAliveInterval 60
    ServerAliveCountMax 3

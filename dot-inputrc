# case insensitive completion
set completion-ignore-case on
set completion-map-case    on

# inmediatly show available completions
set show-all-if-ambiguous  on
set show-all-if-unmodified on

set history-preserve-point on

$if Bash
    set expand-tilde on

    "\e/": dabbrev-expand
    "\et": complete
    "\eh": history-and-alias-expand-line
    "\e`": tilde-expand
    "\t": "\et\eh\e`" # in order: complete, history expand, alias expand, tilde expand
$endif